{
  "name": "bedre-oekonomi",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-23",
  "containers": [
    {
      "class_name": "AppContainer",
      "scheduling_policy": "durable_object",
      "max_instances": 1,
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "APP_CONTAINER",
        "class_name": "AppContainer"
      }
    ]
  },
  "exports": {
    "AppContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
